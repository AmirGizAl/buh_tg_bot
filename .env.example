# Token from @BotFather
BOT_TOKEN=

# Telegram user id of the Owner (bootstrapped on first launch; further employees are
# added from inside the bot itself, see README)
OWNER_ID=

# Telegram chat id of the single shared group chat (bot must be a member/admin there).
# Negative number for a normal group, e.g. -1001234567890 for a supergroup.
GROUP_CHAT_ID=

# Path to the sqlite database file (inside the container this is /app/data/bot.db)
DB_PATH=data/bot.db

# Optional: proxy to reach api.telegram.org, needed if your ISP blocks Telegram directly.
# Supports http://, https://, socks4://, socks5:// — e.g. socks5://user:pass@1.2.3.4:1080
# If you use the bundled hysteria2 sidecar (see hysteria/config.example.yaml), leave this as
# socks5://127.0.0.1:1080 since network_mode: host makes it reachable via localhost.
PROXY_URL=
